---
// Playful dead end (plan §4): "¯\_(ツ)_/¯ 404: not found, but here's a flag".
import Base from '../layouts/Base.astro';
import MenuBar from '../components/MenuBar.astro';
import TerminalFooter from '../components/TerminalFooter.astro';
import { withBase } from '../lib/base';
---

<Base title="404 — not found" description="This page doesn't exist.">
  <MenuBar slot="menubar" />

  <section class="nf">
    <div class="wrap nf__inner">
      <p class="nf__kao mono" aria-hidden="true">¯\\_(ツ)_/¯</p>
      <h1 class="nf__code mono">404</h1>
      <p class="nf__msg">not found — but here's a flag.</p>
      <p class="nf__flag mono">flag{'{'}y0u_f0und_th3_404{'}'}</p>
      <div class="nf__actions">
        <a class="btn btn--accent" href={withBase("/")}>back home</a>
        <button class="btn" type="button" data-cmdk-open><kbd class="mono">⌘K</kbd> jump to…</button>
      </div>
    </div>
  </section>

  <TerminalFooter slot="footer" />
</Base>

<style>
  .nf { min-height: 70svh; display: flex; align-items: center; padding-top: var(--menubar-h); }
  .nf__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
  .nf__kao { font-size: clamp(1.5rem, 6vw, 3rem); color: var(--ink-3); }
  .nf__code { font-size: clamp(4rem, 22vw, 12rem); font-weight: 500; line-height: 1; color: var(--accent); letter-spacing: -0.04em; }
  .nf__msg { font-size: var(--fs-md); color: var(--ink-2); }
  .nf__flag { color: var(--ink-4); font-size: var(--fs-sm); }
  .nf__actions { display: flex; gap: 0.6rem; margin-top: 1rem; flex-wrap: wrap; justify-content: center; }
</style>
