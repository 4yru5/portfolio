---
import Base from '../layouts/Base.astro';
import MenuBar from '../components/MenuBar.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import BentoFocus from '../components/BentoFocus.astro';
import CtfHighlight from '../components/CtfHighlight.astro';
import Projects from '../components/Projects.astro';
import Timeline from '../components/Timeline.astro';
import Writing from '../components/Writing.astro';
import Desktop from '../components/Desktop.astro';
import TerminalFooter from '../components/TerminalFooter.astro';
---

<Base>
  <MenuBar slot="menubar" />

  <Hero />
  <Statement />
  <BentoFocus />
  <CtfHighlight />
  <Projects />
  <Timeline />
  <Writing />
  <Desktop />

  <TerminalFooter slot="footer" />
</Base>

<!-- GSAP pinned scenes: home page only, loaded lazily (plan §5/§8) -->
<script>
  import '../islands/scroll-scenes.ts';
</script>
