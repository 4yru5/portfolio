---
// Scene 8 — After hours / Miscellany (plan §4).
// The person behind the work: a Rubik's cube that scrambles & solves on click,
// a chess puzzle window, a "now playing" guitar widget, a surf note, a kayak
// photo, a karting clip, kaomoji stickers. HeyClicky playfulness lives here (plan §2).
import { withBase } from '../lib/base';

// chess.com integration — pull live ratings at build time (no runtime fetch, so
// nothing to loosen in the CSP). Refreshes on every deploy; falls back to the
// last-known numbers if the API is unreachable so the build never breaks.
const CHESS_USER = 'suryaaravii';
const CHESS_URL = `https://www.chess.com/member/${CHESS_USER}`;
async function getChessStats() {
  const fallback = { rapid: 1115, blitz: 998, bullet: 611 };
  try {
    const res = await fetch(`https://api.chess.com/pub/player/${CHESS_USER}/stats`, {
      headers: { 'User-Agent': 'suryaravi-portfolio (+https://4yru5.github.io)' },
    });
    if (!res.ok) return fallback;
    const d: any = await res.json();
    return {
      rapid: d?.chess_rapid?.last?.rating ?? fallback.rapid,
      blitz: d?.chess_blitz?.last?.rating ?? fallback.blitz,
      bullet: d?.chess_bullet?.last?.rating ?? fallback.bullet,
    };
  } catch {
    return fallback;
  }
}
const chess = await getChessStats();

// Real position for the board backdrop (chess.com green/cream). Index 0 = a8,
// 63 = h1. [square index, glyph, colour]. Last move highlighted on c7 → c4.
const chessPieces: Array<[number, string, 'w' | 'b']> = [
  [5, '♚', 'b'], [7, '♜', 'b'],                                   // rank 8: Kf8, Rh8
  [13, '♝', 'b'], [14, '♟', 'b'], [15, '♟', 'b'],                 // rank 7: Bf7, g7, h7
  [16, '♞', 'w'], [17, '♟', 'b'], [19, '♞', 'b'], [21, '♟', 'b'], // rank 6: Na6, b6, Nd6, f6
  [27, '♟', 'w'], [29, '♟', 'w'],                                 // rank 5: d5, f5
  [32, '♟', 'w'], [33, '♟', 'w'], [34, '♛', 'b'], [38, '♟', 'w'], // rank 4: a4, b4, Qc4, g4
  [47, '♟', 'w'],                                                 // rank 3: h3
  [53, '♛', 'w'],                                                 // rank 2: Qf2
  [60, '♜', 'w'], [62, '♚', 'w'],                                 // rank 1: Re1, Kg1
];
const pieceAt = new Map(chessPieces.map(([i, p, c]) => [i, { p, c }]));
const chessHighlights = new Set([10, 34]); // c7, c4
---

<section id="desktop" class="desktop section" data-drag-bounds>
  <div class="wrap">
    <p class="eyebrow reveal">after hours</p>
    <h2 class="desktop__title reveal">The person behind the work.</h2>
  </div>

  <div class="desktop__stage">
    <!-- chess.com — live ratings baked in at build, board as backdrop, label beneath -->
    <figure class="deskwin deskwin--chess" data-drag>
      <div class="deskwin__frame chesscard">
        <div class="chesscard__board" aria-hidden="true">
          {Array.from({ length: 64 }).map((_, i) => {
            const r = Math.floor(i / 8);
            const dark = (r + i) % 2 === 1;
            const cell = pieceAt.get(i);
            const hot = chessHighlights.has(i);
            return (
              <span class={`csq ${dark ? 'csq--d' : ''} ${hot ? 'csq--hot' : ''}`}>
                {cell && <span class={`cpiece cpiece--${cell.c}`}>{cell.p}</span>}
              </span>
            );
          })}
        </div>
        <div class="chesscard__bar">
          <a class="chesscard__user mono" href={CHESS_URL} target="_blank" rel="noopener">@{CHESS_USER} ↗</a>
          <dl class="chesscard__ratings mono" aria-label="chess.com ratings">
            <div><dt>rapid</dt><dd>{chess.rapid}</dd></div>
            <div><dt>blitz</dt><dd>{chess.blitz}</dd></div>
            <div><dt>bullet</dt><dd>{chess.bullet}</dd></div>
          </dl>
        </div>
      </div>
      <figcaption class="deskwin__cap mono">chess</figcaption>
    </figure>

    <!-- kayak photo (hobby) — bare rounded image with a terminal-style label beneath -->
    <figure class="deskwin deskwin--photo" data-drag>
      <div class="deskwin__frame">
        <img
          class="deskwin__photo"
          src={withBase('/media/kayak-sunset.jpg')}
          width="1000"
          height="565"
          loading="lazy"
          decoding="async"
          alt="Paddling a kayak into the sunset on the Kerala backwaters, paddle held overhead."
        />
      </div>
      <figcaption class="deskwin__cap mono">kayaking</figcaption>
    </figure>

    <!-- karting clip (hobby) — bare rounded video, always autoplaying, label beneath -->
    <figure class="deskwin deskwin--video" data-drag>
      <div class="deskwin__frame">
        <video
          class="deskwin__video"
          src={withBase('/media/karting.mp4')}
          poster={withBase('/media/karting-poster.jpg')}
          width="600"
          height="798"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label="Go-karting — taking a corner on a kart track at sunset."
        ></video>
      </div>
      <figcaption class="deskwin__cap mono">karting</figcaption>
    </figure>

    <!-- surfing photo (hobby) — 1:1, subject centred, label beneath -->
    <figure class="deskwin deskwin--surfing" data-drag>
      <div class="deskwin__frame">
        <img
          class="deskwin__photo"
          src={withBase('/media/surfing.jpg')}
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
          alt="Walking along the beach carrying a blue surfboard, waves rolling in behind."
        />
      </div>
      <figcaption class="deskwin__cap mono">surfing</figcaption>
    </figure>

  </div>
</section>

<style>
  .desktop__title { font-size: var(--fs-lg); margin: 0.75rem 0 2.5rem; }
  .desktop__stage {
    position: relative;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  @media (min-width: 860px) and (prefers-reduced-motion: no-preference) {
    .desktop__stage { display: block; min-height: 640px; }
    .deskwin { position: absolute; }
    .deskwin--chess { top: 20px; left: 2%; transform: rotate(-1deg); }
    .deskwin--photo { top: 0; left: 40%; transform: rotate(1.5deg); }
    .deskwin--surfing { top: 318px; left: 6%; transform: rotate(1deg); }
    .deskwin--video { top: 300px; left: 44%; transform: rotate(-1.5deg); }
  }
  .deskwin { width: min(300px, 90vw); }

  /* ---- kayak photo + karting video + surfing photo (hobbies) ---- */
  /* bare rounded-corner media (no title bar) with a terminal-style label beneath */
  .deskwin--photo, .deskwin--video, .deskwin--surfing { margin: 0; }
  .deskwin--video, .deskwin--surfing { width: min(220px, 70vw); }
  .deskwin__frame {
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lift);
    background: #000;
  }
  .deskwin__photo, .deskwin__video { display: block; width: 100%; height: auto; }
  .deskwin__cap { margin: 0.4rem 0 0; text-align: center; font-size: var(--fs-xs); color: var(--ink-4); }

  /* ---- chess.com card (bare frame + caption, matches the photo/video tiles) ---- */
  .deskwin--chess { margin: 0; width: min(240px, 72vw); }
  .chesscard { position: relative; }
  .chesscard__board {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    aspect-ratio: 1;
  }
  /* chess.com board palette */
  .csq { display: grid; place-items: center; background: #ebecd0; }
  .csq--d { background: #739552; }
  .csq--hot { background: #f7ec74; }           /* last-move, light square */
  .csq--d.csq--hot { background: #bbcb45; }     /* last-move, dark square */
  .cpiece {
    font-size: clamp(0.85rem, 3.8vw, 1.2rem);
    line-height: 1;
  }
  .cpiece--w { color: #fafafa; text-shadow: 0 0 1px rgba(0,0,0,.6), 0 1px 1px rgba(0,0,0,.35); }
  .cpiece--b { color: #3b3938; text-shadow: 0 0 1px rgba(0,0,0,.3); }
  /* live ratings strip, glassed over the foot of the board */
  .chesscard__bar {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.4rem 0.7rem 0.6rem;
    background: linear-gradient(to top, rgba(0,0,0,.92) 55%, transparent);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .chesscard__user { font-size: var(--fs-xs); color: #d8d8d8; align-self: flex-start; }
  .chesscard__user:hover { color: var(--accent); text-decoration: none; }
  .chesscard__ratings { display: flex; gap: 0.9rem; margin: 0; }
  .chesscard__ratings div { display: flex; flex-direction: column; line-height: 1.1; }
  .chesscard__ratings dt { font-size: 0.6rem; letter-spacing: 0.08em; color: #8a8a8a; text-transform: uppercase; }
  .chesscard__ratings dd { margin: 0; font-size: var(--fs-sm); font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
</style>

<script>
  // keep the hobby clip looping forever — never require a tap on the play button
  document.querySelectorAll<HTMLVideoElement>('.deskwin__video').forEach((v) => {
    v.muted = true;
    v.defaultMuted = true;
    v.loop = true;
    const play = () => { const p = v.play(); if (p) p.catch(() => {}); };
    // play on load, whenever it scrolls into view, and if it ever ends/stalls
    v.addEventListener('canplay', play);
    v.addEventListener('loadeddata', play);
    v.addEventListener('ended', play);
    v.addEventListener('pause', () => { if (!document.hidden) play(); });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && play()),
        { threshold: 0.1 }
      ).observe(v);
    }
    document.addEventListener('visibilitychange', () => { if (!document.hidden) play(); });
    // last resort: resume on the first interaction if a strict policy blocked autoplay
    const once = () => { play(); removeEventListener('pointerdown', once); removeEventListener('keydown', once); };
    addEventListener('pointerdown', once, { passive: true });
    addEventListener('keydown', once);
    play();
  });
</script>
