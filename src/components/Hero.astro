---
// Scene 1 — Hero (plan §4).
// Giant name that decodes 4YRU5 ⇄ SURYA, a "Hello my name is" sticker,
// focus tags as pills, CV + GitHub buttons.
import { withBase } from '../lib/base';
const focus = ['appsec', 'api security', 'ai / llm', 'threat exposure'];
---

<section id="top" class="hero" data-scene="hero">
  <div class="wrap hero__inner">
    <p class="eyebrow hero__eyebrow reveal">security researcher</p>

    <h1 class="hero__name">
      <decode-text data-from="SURYA" data-to="4YRU5" class="hero__decode">4YRU5</decode-text>
    </h1>

    <div class="hero__sub reveal">
      <p class="hero__lead">
        Surya Ravi. I study how systems fail and how trust breaks —
        across application security, APIs and AI.
      </p>
    </div>

    <ul class="hero__tags reveal-stagger" aria-label="Focus areas">
      {focus.map((f) => <li class="pill">{f}</li>)}
    </ul>

    <div class="hero__actions reveal">
      <a class="btn btn--accent" href={withBase("/cv")}>View CV ↗</a>
      <a class="btn" href="https://github.com/4yru5" target="_blank" rel="noopener">
        GitHub ↗
      </a>
      <button class="btn" type="button" data-cmdk-open>
        <kbd class="mono">⌘K</kbd> jump to…
      </button>
    </div>

    <a href="#statement" class="hero__scroll mono reveal" aria-label="Scroll down">
      <span>scroll</span>
      <span class="hero__scroll-arrow">↓</span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: var(--menubar-h);
  }
  .hero__inner { display: flex; flex-direction: column; gap: 1.5rem; width: 100%; }
  .hero__eyebrow { font-size: var(--fs-sm); }

  .hero__name {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .hero__decode {
    display: inline-block;
    cursor: pointer;
    font-variant-ligatures: none;
    background: linear-gradient(180deg, var(--ink), var(--ink-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    outline-offset: 8px;
  }
  .hero__decode:hover { background: linear-gradient(180deg, var(--accent), var(--accent-hover)); -webkit-background-clip: text; background-clip: text; }

  .hero__sub { max-width: 46ch; }
  .hero__lead { font-size: var(--fs-md); color: var(--ink-2); line-height: var(--lh-snug); }

  .hero__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.25rem 0 0; padding: 0; }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.5rem; }
  .hero__actions kbd { font-size: 0.85em; }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    font-size: var(--fs-xs);
    color: var(--ink-3);
    margin-top: 1.5rem;
  }
  .hero__scroll:hover { color: var(--accent); text-decoration: none; }
  .hero__scroll-arrow { animation: bob 2s var(--ease-in-out) infinite; }
  @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-arrow { animation: none; } }
</style>
