---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MenuBar from '../../components/MenuBar.astro';
import TerminalFooter from '../../components/TerminalFooter.astro';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  // Posts that live elsewhere (Medium) link out; only local posts get a page.
  return posts
    .filter((p) => !p.data.external)
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`${post.data.title} — Surya Ravi`} description={post.data.summary}>
  <MenuBar slot="menubar" />

  <article class="section">
    <div class="wrap">
      <a class="mono post-back" href={withBase("/writing")}>← writing</a>
      <header class="post-head">
        <time class="mono post-date" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <h1 class="post-title">{post.data.title}</h1>
        <ul class="post-tags" aria-label="Tags">
          {post.data.tags.map((t) => <li class="pill mono">#{t}</li>)}
        </ul>
      </header>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <TerminalFooter slot="footer" />
</Base>

<style>
  .post-back { display: inline-block; color: var(--ink-3); font-size: var(--fs-sm); margin-bottom: 2rem; }
  .post-head { max-width: 68ch; margin-bottom: 2.5rem; }
  .post-date { color: var(--ink-4); font-size: var(--fs-sm); }
  .post-title { font-size: var(--fs-xl); margin: 0.5rem 0 1rem; }
  .post-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; }
  .prose { max-width: 68ch; }
  .prose :global(h2) { font-size: var(--fs-lg); margin: 2.5rem 0 1rem; }
  .prose :global(p) { margin: 0 0 1.2rem; color: var(--ink-2); }
  .prose :global(blockquote) { border-left: 2px solid var(--accent); padding-left: 1rem; color: var(--ink-3); font-style: italic; }
  .prose :global(pre) { background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 1rem; overflow: auto; }
</style>
